{
  "name": "quick-chat",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names client,server \"pnpm --filter ./client run dev\" \"pnpm --filter ./server run dev\"",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.5",
    "vitest": "^5.0.0"
  }
}
