NODE_ENV=production
APP_URL=https://your-project.vercel.app
ALLOWED_ORIGINS=https://your-project.vercel.app
DATABASE_URL=postgresql://user:password@pooled-host.example.com/neondb?sslmode=require
# Direct URL is only needed in the trusted migration environment.
DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host.example.com/neondb?sslmode=require
RATE_LIMIT_SALT=replace-with-a-unique-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-provider-username
SMTP_PASS=replace-with-provider-password
SMTP_FROM=Quickchat <no-reply@example.com>
COOKIE_SAME_SITE=Lax
SESSION_TTL_DAYS=30
GUEST_MESSAGE_LIMIT_PER_DAY=50
USER_MESSAGE_LIMIT_PER_DAY=1000
GLOBAL_RATE_LIMIT_PER_MINUTE=300
