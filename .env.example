NODE_ENV=production
PORT=3000
APP_URL=https://chat.example.com
ALLOWED_ORIGINS=https://chat.example.com
DATABASE_URL=postgres://user:password@postgres.example.com:5432/quickchat?sslmode=require
REDIS_URL=rediss://user:password@redis.example.com:6379
SESSION_TTL_DAYS=30
COOKIE_SAME_SITE=Lax
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
GLOBAL_RATE_LIMIT_PER_MINUTE=300
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Quickchat <no-reply@example.com>
S3_REGION=ap-south-1
S3_BUCKET=quickchat-media
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_BYTES=26214400
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
WORKER_INTERVAL_MS=5000
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
GUEST_MESSAGE_LIMIT_PER_DAY=50
USER_MESSAGE_LIMIT_PER_DAY=1000
GUEST_VOICE_LIMIT_PER_DAY=10
USER_FILE_LIMIT_PER_DAY=100
