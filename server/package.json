{
  "name": "hono",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@quickchat/contracts": "workspace:*",
    "@sentry/node": "^11.1.0",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.7",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vercel": "^59.11.2",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start": "node dist/index.js",
    "release:migrate": "node --env-file-if-exists=.env dist/migrate.js"
  }
}
